# Copy to .env (gitignored) and fill in.
# GEMINI_API_KEY and JWT_SECRET now live in Azure Key Vault (azureops-copilot-kv,
# Module 11) for real Azure deployments -- set AZURE_KEY_VAULT_NAME there instead
# and leave these two blank. Local docker-compose dev keeps using the values below.

GEMINI_API_KEY=

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=azureops_docs

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-change-me

# AZURE_KEY_VAULT_NAME=azureops-copilot-kv
